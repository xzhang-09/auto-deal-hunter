# LLM (scan pipeline + RAG estimator)
OPENAI_API_KEY=your-openai-api-key
# Scan path: "direct" (default, in-process) or "agent" (MCP tool-calling loop demo).
SCAN_MODE=direct
# Model + inference settings (shared by every agent). temperature=0 + seed for reproducibility.
LLM_MODEL=gpt-4o-mini
# Optional per-agent overrides. Leave blank/unset to inherit LLM_MODEL.
SCANNER_MODEL=
PRICER_MODEL=
MESSAGING_MODEL=
JUDGE_MODEL=
MCP_MODEL=
# OpenAI API surface: responses (default) or chat for OpenAI-compatible endpoints that do not
# implement Responses API.
OPENAI_API_STYLE=responses
LLM_TEMPERATURE=0
LLM_SEED=42
# Automatic retries (exponential backoff) for transient OpenAI errors, per client.
LLM_MAX_RETRIES=3
# Embedding model for the RAG vector store. MUST match between build and query, or the
# query path will refuse to run (the build stamps this name into the collection metadata).
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# Minimum retrieval confidence (0..1) for a deal to earn a push notification. Low-confidence
# deals (no close comparable in the vector store) are still saved but not pushed. 0 disables.
RAG_MIN_CONFIDENCE=0.15
# Estimates above this multiple of list price are treated as retrieval mismatches: push
# withheld, dashboard shows the estimate as unreliable. Savings stay list-price-capped.
ESTIMATE_MISMATCH_RATIO=2.0
# Optional second-stage retrieval reranker: off, cross-encoder, or llm.
# cross-encoder improves comparable ordering locally but adds model load/runtime cost.
RERANK_MODE=off
RERANK_CANDIDATES=20
# Set to 0/off/false to disable the on-disk cache of scraped DealNews pages.
DEALHUNTER_HTTP_CACHE=1

# HuggingFace (McAuley-Lab/Amazon-Reviews-2023 download)
HF_TOKEN=your-huggingface-token

# Telegram Bot (recommended push notifications for deals)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
# Receive Good/Bad button clicks with Telegram long polling and save them to DEALS_DB_PATH.
TELEGRAM_FEEDBACK_ENABLED=true
TELEGRAM_POLL_TIMEOUT_SECONDS=25

# Pushover (optional fallback push notifications; used only if Telegram is not configured)
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Runtime state
DEALS_DB_PATH=data/deals.sqlite
# Drop opportunities not re-confirmed within this many hours (deals expire on DealNews).
# Set to 0 to disable expiry and keep every opportunity forever.
DEALS_TTL_HOURS=72
# Optional: override imported memory path
MEMORY_FILENAME=data/memory.json

# Vector store build (scripts/build_vector_store.py)
PRODUCTS_VECTORSTORE_PATH=data/products_vectorstore
MCAULEY_CATEGORY=Electronics       # McAuley-Lab category to pull (covers DealNews Electronics/Computers/Smart Home)
MCAULEY_MAX_ITEMS=50000            # cap on items embedded into the vector store
EVAL_HOLDOUT_SIZE=500              # items held out (not embedded) for eval_pricers.py
EVAL_HOLDOUT_PATH=data/eval_holdout.json
